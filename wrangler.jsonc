{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekee-official-site",
  "compatibility_date": "2026-08-13",
  "pages_build_output_dir": "dist",
  "vars": {
    "ALLOWED_SUPPORT_ORIGINS": "https://lekeopen.com",
    "SUPPORT_MAIL_FROM": "乐可开源产品支持 <support@lekeopen.com>",
    "SUPPORT_MAIL_TO": "contact@lekeopen.com",
    "LEZHI_FEEDBACK_URL": "https://lezhi.lekeopen.com/api/v1/product-feedback",
    "DOMESTIC_DOWNLOADS_ENABLED": "true",
    "DOWNLOAD_CDN_HOST": "downloads.lekeopen.com",
    "DOWNLOAD_URL_TTL_SECONDS": "120"
  },
  "kv_namespaces": [
    {
      "binding": "SUPPORT_RATE_LIMIT",
      "id": "02d2e0e3045145bd933fddec330f9138"
    },
    {
      "binding": "DOWNLOAD_RATE_LIMIT",
      "id": "01e4a2197e364c849858e7ee7e1a8cf6"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "ALLOWED_SUPPORT_ORIGINS": "https://codex-product-support-design.lekee-official-site.pages.dev",
        "SUPPORT_MAIL_FROM": "乐可开源产品支持 <support@lekeopen.com>",
        "SUPPORT_MAIL_TO": "contact@lekeopen.com",
        "LEZHI_FEEDBACK_URL": "https://lezhi.lekeopen.com/api/v1/product-feedback",
        "DOMESTIC_DOWNLOADS_ENABLED": "false",
        "DOWNLOAD_CDN_HOST": "downloads.lekeopen.com",
        "DOWNLOAD_URL_TTL_SECONDS": "120"
      },
      "kv_namespaces": [
        {
          "binding": "SUPPORT_RATE_LIMIT",
          "id": "433c07ec5a704ab8a72360861fb83f62"
        },
        {
          "binding": "DOWNLOAD_RATE_LIMIT",
          "id": "2dd2868bb88a453fbece42ead3e88801"
        }
      ]
    }
  }
}
