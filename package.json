{
  "name": "leke-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify": "npm run validate:content && npm run check && npm run lint && npm run build && npm test && npm run check:seo && npm run verify:seo-ops && npm run check:bundle",
    "build": "npm run build:og && npm run build:support-data && npm run build:products && npm run build:rss && npm run publish:queue && tsc -b && vite build && npm run build:ssr && npm run prerender",
    "build:support-data": "node scripts/generate-support-release-data.mjs",
    "build:products": "node scripts/generate-product-assets.mjs",
    "build:og": "node scripts/generate-default-og.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .seo-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build:rss": "node --loader ts-node/esm scripts/generate-rss.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:seo": "node scripts/validate-seo-build.mjs",
    "check:seo-keywords": "node scripts/validate-seo-keywords.mjs",
    "verify:seo-ops": "npm run seo:inventory && npm run check:seo-keywords && node --test tests/seo-ops-*.test.mjs",
    "seo:inventory": "node tools/seo-ops/src/cli.mjs inventory",
    "seo:inspect": "node tools/seo-ops/src/cli.mjs inspect",
    "seo:submit": "node tools/seo-ops/src/cli.mjs submit",
    "seo:report": "node tools/seo-ops/src/cli.mjs report",
    "generate-rss": "node --loader ts-node/esm scripts/generate-rss.ts",
    "publish:queue": "node --loader ts-node/esm scripts/generate-publish-queue.js",
    "products:releases:check": "node scripts/product-release-monitor.mjs",
    "products:releases:mirror:dry-run": "node scripts/product-release-mirror.mjs",
    "wechat": "node tools/wechat-admin/src/cli.mjs",
    "wechat:accounts": "node tools/wechat-admin/src/cli.mjs accounts",
    "wechat:menu:get": "node tools/wechat-admin/src/cli.mjs menu get",
    "wechat:menu:sync": "node tools/wechat-admin/src/cli.mjs menu sync",
    "wechat:menu:delete": "node tools/wechat-admin/src/cli.mjs menu delete",
    "wechat:replies": "node tools/wechat-admin/src/cli.mjs replies show",
    "wechat:article": "node tools/wechat-admin/src/cli.mjs article render",
    "wechat:article:preview": "node tools/wechat-admin/src/cli.mjs article preview",
    "wechat:draft": "node tools/wechat-admin/src/cli.mjs draft create",
    "prepare": "husky"
  },
  "lint-staged": {
    "content/news/*.md": [
      "npm run generate-rss",
      "npm run publish:queue",
      "git add public/rss.xml publish-queue.json"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "front-matter": "^4.0.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "cheerio": "^1.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^13.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
