VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Product support public browser value (not a secret)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Product support server-only variables and secrets. Configure in Cloudflare,
# never place real values in a VITE_* variable or commit them to this file.
ALLOWED_SUPPORT_ORIGINS=https://lekeopen.com
TURNSTILE_SECRET_KEY=server_secret_placeholder
RESEND_API_KEY=server_token_placeholder
SUPPORT_MAIL_FROM=乐可开源产品支持 <support@lekeopen.com>
SUPPORT_MAIL_TO=support@lekeopen.com

# WeChat Official Account management
# Keep real values in .env only. Use one pair per account.
WECHAT_LEKEOPEN_APP_ID=your_app_id
WECHAT_LEKEOPEN_APP_SECRET=your_app_secret
